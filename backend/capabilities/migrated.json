{
  "identifier": "migrated",
  "description": "Main window: JSON export to user-selected files and one fixed automatic DTC log",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/dtc_log.json"
        }
      ]
    },
    "core:window:allow-close",
    "shell:allow-open",
    "dialog:allow-save",
    "shell:default"
  ]
}
