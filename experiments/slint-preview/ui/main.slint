import { Button, VerticalBox } from "std-widgets.slint";

export component PreviewWindow inherits Window {
    title: "OBDium | Slint preview";
    preferred-width: 720px;
    preferred-height: 420px;
    min-width: 360px;
    min-height: 340px;
    in property <bool> demo-active: false;
    in property <string> rpm-text: "Unavailable";
    callback toggle-demo();

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        Text {
            text: "OBDium";
            font-size: 28px;
        }
        Text {
            text: "Native desktop migration preview";
            font-size: 18px;
            wrap: word-wrap;
        }
        Text {
            text: root.demo-active ? "SYNTHETIC DEMO — no vehicle connected" : "DISCONNECTED — no vehicle connected";
            wrap: word-wrap;
        }
        Text {
            text: "Engine speed";
        }
        Text {
            text: root.rpm-text;
            font-size: 24px;
            wrap: word-wrap;
        }
        Button {
            text: root.demo-active ? "End synthetic demo" : "Start synthetic demo";
            clicked => { root.toggle-demo(); }
        }
        Text {
            text: "Offline preview only. No adapter access, ECU commands or database writes.";
            wrap: word-wrap;
        }
    }
}
